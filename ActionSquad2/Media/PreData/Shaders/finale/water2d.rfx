    <RmModelData NAME="ScreenAlignedQuad" API="" FILE_NAME="..\..\..\..\..\..\..\..\winapps\RenderMonkey 1.82\Examples\Media\Models\CrackedQuad.3ds" ORIENTATION="0"/>
    <RmPass NAME="Single Pass" API="D3D" PASS_INDEX="0" ENABLED="TRUE">
     <RmModelReference NAME="ScreenAlignedQuad" API=""/>
     <RmRenderStateBlock NAME="Render State" API="D3D">
      <RmState NAME="D3DRS_CULLMODE" API="D3D" STATE="22" VALUE="1" USAGE="RENDER_STATE"/>
      <RmState NAME="D3DRS_ALPHABLENDENABLE" API="D3D" STATE="27" VALUE="1" USAGE="RENDER_STATE"/>
      <RmState NAME="D3DRS_ALPHATESTENABLE" API="D3D" STATE="15" VALUE="0" USAGE="RENDER_STATE"/>
      <RmState NAME="D3DRS_DESTBLEND" API="D3D" STATE="20" VALUE="6" USAGE="RENDER_STATE"/>
      <RmState NAME="D3DRS_SRCBLEND" API="D3D" STATE="19" VALUE="5" USAGE="RENDER_STATE"/>
     </RmRenderStateBlock>
     <RmHLSLShader NAME="Vertex Shader" API="D3D" PIXEL_SHADER="FALSE" TARGET="vs_2_0" ENTRY_POINT="vs_main" COMPILER_FLAGS="32"><RmShaderCode TYPE="TEXT"><![CDATA[
float4x4 matViewProjection;
//pentru a calcula coord in RTT aici in shader
float4 RTTxywh;
float4 RTTtex_xywh;
//params apa
float4 fWaterOffsets; //xy si zw sunt 2 vectori de offsets in fn de timp

struct VS_INPUT 
{
   float4 Position : POSITION0;
   float3 Normal : NORMAL;       //not used
   float4 Color : COLOR0;         //culoare apa, alpha pentru opacitate apa
   float2 Tex0 : TEXCOORD0;      //textura de distort a apei (normal map)
   float2 Tex1 : TEXCOORD1;      //textura din RTarget
   
};
//versiune cu culoare vertex si calculare automata de coord textura RTT
struct VS_OUTPUT 
{
   float4 Position :        POSITION0;
   float4 Color :           COLOR0;
   float4 Tex0 :            TEXCOORD0; //textura apei (xy, zw sunt 2 pozitii separate in fn de timp)
   float2 Tex1:             TEXCOORD1;
};

VS_OUTPUT vs_main( VS_INPUT Input )
{
   VS_OUTPUT Output;

   Output.Position         = mul( Input.Position, matViewProjection );

   Output.Color = Input.Color; //culoarea apei din C++
    //adauga la coord textura apa offseturile in fn de timp si grupez cei 2 vectory xy si zw pe o sg coord tex
   Output.Tex0 = Input.Tex0.xyxy + fWaterOffsets;
   //calculez tex1 (RTT) in fn de coordonatele vertexului (inainte sa transform pozitia)
   //ca optimizare (2 instructiuni asm) le salvez in vectori.xy
   float2 RTTxy, RTTwh;
   float2 RTTtex_xy, RTTtex_wh;
   RTTxy = RTTxywh.xy; RTTwh = RTTxywh.zw;
   RTTtex_xy = RTTtex_xywh.xy; RTTtex_wh = RTTtex_xywh.zw;
   Output.Tex1 = ((Input.Position.xy - RTTxy) / RTTwh) * RTTtex_wh + RTTtex_xy;
   
   return( Output );
   
}
]]></RmShaderCode>
      <RmShaderConstant NAME="RTTtex_xywh" API="" REGISTER="5"/>
      <RmShaderConstant NAME="RTTxywh" API="" REGISTER="4"/>
      <RmShaderConstant NAME="fWaterOffsets" API="" REGISTER="6"/>
      <RmShaderConstant NAME="matViewProjection" API="" REGISTER="0"/>
     </RmHLSLShader>
     <RmHLSLShader NAME="Pixel Shader" API="D3D" PIXEL_SHADER="TRUE" TARGET="ps_2_0" ENTRY_POINT="ps_main" COMPILER_FLAGS="0"><RmShaderCode TYPE="TEXT"><![CDATA[
float4 fWaterData; //x=distort, y=Caustics Alpha

sampler2D texAll;  //textura render target (ul-diffuse, ur-normal+height, dl-specular power?)
sampler2D texWaterNorm; //textura apa - normal map (xy folosit, zw liber)

struct PS_INPUT 
{
   float4 VertColor:       COLOR0;    //culoare apa (alpha pt transparenta apa)
   float4 Tex0:            TEXCOORD0; //coordonate textura apa cu offsets (2 vec xy si zw)
   float2 Tex1:            TEXCOORD1; //textura render target
};


//varianta cu culoarea apei luata din c++
/*
float4 ps_main( PS_INPUT Input ) : COLOR0
{
   //iau date normale apa
   float2 waterNrm1 = tex2D(texWaterNorm, Input.Tex0.xy).xy - 0.5f;
   float2 waterNrm2 = tex2D(texWaterNorm, Input.Tex0.zw).xy - 0.5f;
   
   float2 waterNrm = fWaterData.x * (waterNrm1 + waterNrm2);
   
   //culoare apa plus caustics
   float4 waterDiffuse = float4(Input.VertColor.xyz + waterNrm.y * fWaterData.y, 1.0f);
   //float4 waterDiffuse = float4(waterColor.xyz + saturate(waterNrm.y * fCaustics), 1.0f);
   
   float4 diffuseCol = lerp(waterDiffuse, tex2D(texAll, Input.Tex1 + waterNrm), Input.VertColor.w);
   
   return saturate(diffuseCol);
}
*/

//varianta cu caustics - textura apei are XY normala iar pe Z avem textura caustics
float4 ps_main( PS_INPUT Input ) : COLOR0
{
   //aflu culoare nava
   float3 tex1 = tex2D(texWaterNorm, Input.Tex0.xy);
   float3 tex2 = tex2D(texWaterNorm, Input.Tex0.zw);

   float fCausticsTex = (tex1.z + tex2.z);
   //scad 1 pentru a aduce normalele in spatiul -1 -> 1 (erau in 0-2)
   float2 waterNrm = fWaterData.x * (tex1.xy + tex2.xy - 1.0f);
   
   float4 sceneCol = tex2D(texAll, Input.Tex1 + waterNrm.xy);
   float4 diffuseCol = sceneCol * Input.VertColor.xyzw + fWaterData.y * fCausticsTex * sceneCol;
   
   return saturate(diffuseCol);
}]]></RmShaderCode>
      <RmSampler NAME="texAll" API="" REGISTER="0"/>
      <RmSampler NAME="texWaterNorm" API="" REGISTER="1"/>
      <RmShaderConstant NAME="fWaterData" API="" REGISTER="0"/>
     </RmHLSLShader>
     <RmStreamMapReference NAME="Stream Mapping" API=""/>
     <RmTextureObject NAME="texAll" API="D3D" STATE_INDEX="0" VERTEX_TEXTURE="FALSE">
      <RmTextureReference NAME="texAll" API=""/>
      <RmState NAME="D3DSAMP_MAGFILTER" API="D3D" STATE="5" VALUE="1" USAGE="SAMPLER_STATE"/>
      <RmState NAME="D3DSAMP_MINFILTER" API="D3D" STATE="6" VALUE="1" USAGE="SAMPLER_STATE"/>
      <RmState NAME="D3DSAMP_MIPFILTER" API="D3D" STATE="7" VALUE="0" USAGE="SAMPLER_STATE"/>
      <RmState NAME="D3DSAMP_ADDRESSU" API="D3D" STATE="1" VALUE="1" USAGE="SAMPLER_STATE"/>
      <RmState NAME="D3DSAMP_ADDRESSV" API="D3D" STATE="2" VALUE="1" USAGE="SAMPLER_STATE"/>
      <RmState NAME="D3DSAMP_ADDRESSW" API="D3D" STATE="3" VALUE="1" USAGE="SAMPLER_STATE"/>
     </RmTextureObject>
     <RmTextureObject NAME="texWaterNorm" API="D3D" STATE_INDEX="1" VERTEX_TEXTURE="FALSE">
      <RmTextureReference NAME="texWaterNorm" API=""/>
     </RmTextureObject>
    </RmPass>
   </RmDirectXEffect>

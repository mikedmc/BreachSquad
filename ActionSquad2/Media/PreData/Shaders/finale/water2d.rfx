     <RmHLSLShader NAME="Vertex Shader" API="D3D" PIXEL_SHADER="FALSE" TARGET="vs_2_0" ENTRY_POINT="vs_main" COMPILER_FLAGS="0"><RmShaderCode TYPE="TEXT"><![CDATA[
float fTimeX, fTimeY;

struct VS_OUTPUT
{
   float4 pos       : POSITION0;
   float2 texCoord  : TEXCOORD0;
   float4 waterCoords : TEXCOORD1;
};

VS_OUTPUT vs_main( float4 inPos: POSITION )
{
   VS_OUTPUT o = (VS_OUTPUT) 0;

   inPos.xy = sign( inPos.xy);
   o.pos = float4( inPos.xy, 0.0f, 1.0f);

   // get into range [0,0.5f]
   o.texCoord = (float2(o.pos.x, -o.pos.y) + 1.0f)/4.0f;
   o.waterCoords.xy = (float2(o.pos.x, -o.pos.y) + 1.0f)/2.0f + float2(fTimeX, fTimeY);
   o.waterCoords.zw = (float2(o.pos.x, -o.pos.y) + 1.0f)/2.0f - float2(fTimeX * 2.0f, fTimeY * 2.0f);
   
   return o;
}
]]></RmShaderCode>
      <RmShaderConstant NAME="fTimeX" API="" REGISTER="0"/>
      <RmShaderConstant NAME="fTimeY" API="" REGISTER="1"/>
     </RmHLSLShader>
     <RmHLSLShader NAME="Pixel Shader" API="D3D" PIXEL_SHADER="TRUE" TARGET="ps_2_0" ENTRY_POINT="ps_main" COMPILER_FLAGS="0"><RmShaderCode TYPE="TEXT"><![CDATA[
float fDistort;  //water distortion level
float fCaustics; //water caustics visibility
float4 waterColor;

sampler2D texAll;
sampler2D texSpot;
//ver1 - prima versiune din joc
/*
float4 ps_main( float2 texCoord  : TEXCOORD0, float4 waterCoord:TEXCOORD1) : COLOR
{
   //aflu culoare nava
   float2 waterNrm1 = tex2D(texSpot, waterCoord.xy).xy - 0.5f;
   float2 waterNrm2 = tex2D(texSpot, waterCoord.zw).xy - 0.5f;
   
   float2 waterNrm = fDistort * (waterNrm1.xy + waterNrm2.xy);
   
   //culoare apa plus caustics
   float4 waterDiffuse = float4(waterColor.xyz + waterNrm.y * fCaustics, 1.0f);
   //float4 waterDiffuse = float4(waterColor.xyz + saturate(waterNrm.y * fCaustics), 1.0f);
   //float4 waterDiffuse = float4(waterColor.xyz + saturate(waterNrm.y * waterNrm.y * fCaustics), 1.0f);
   
   float4 diffuseCol = lerp(waterDiffuse, tex2D(texAll, texCoord + waterNrm.xy), waterColor.w);
   
   return saturate(diffuseCol);
}
*/
float4 ps_main( float2 texCoord  : TEXCOORD0, float4 waterCoord:TEXCOORD1) : COLOR
{
   //aflu culoare nava
   float4 tex1 = tex2D(texSpot, waterCoord.xy);
   float4 tex2 = tex2D(texSpot, waterCoord.zw);

   float fCausticsTex = (tex1.z + tex2.z);
   //scad 1 pentru a aduce normalele in spatiul -1 -> 1 (erau in 0-2)
   float2 waterNrm = fDistort * (tex1.xy + tex2.xy - 1.0f);
   
   float4 sceneCol = tex2D(texAll, texCoord + waterNrm.xy);
   float4 diffuseCol = sceneCol * waterColor + fCaustics * fCausticsTex * sceneCol;
   
   return saturate(diffuseCol);
}

]]></RmShaderCode>
      <RmSampler NAME="texAll" API="" REGISTER="0"/>
      <RmSampler NAME="texSpot" API="" REGISTER="1"/>
      <RmShaderConstant NAME="fCaustics" API="" REGISTER="1"/>
      <RmShaderConstant NAME="fDistort" API="" REGISTER="0"/>
      <RmShaderConstant NAME="waterColor" API="" REGISTER="2"/>
     </RmHLSLShader>
     <RmStreamMapReference NAME="Stream Mapping" API=""/>
     <RmTextureObject NAME="texAll" API="D3D" STATE_INDEX="0" VERTEX_TEXTURE="FALSE">
      <RmTextureReference NAME="texAll" API=""/>
      <RmState NAME="D3DSAMP_MAGFILTER" API="D3D" STATE="5" VALUE="1" USAGE="SAMPLER_STATE"/>

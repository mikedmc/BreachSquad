     <RmHLSLShader NAME="Vertex Shader" API="D3D" PIXEL_SHADER="FALSE" TARGET="vs_2_0" ENTRY_POINT="vs_main" COMPILER_FLAGS="32"><RmShaderCode TYPE="TEXT"><![CDATA[
float4x4 matViewProjection;
//pentru a calcula coord in RTT aici in shader
float4 RTTxywh;
float4 RTTtex_xywh;
//params apa
float4 fWaterOffsets; //xy si zw sunt 2 vectori de offsets in fn de timp

struct VS_INPUT 
{
   float4 Position : POSITION0;
   float3 Normal : NORMAL;       //not used
   float4 Color : COLOR0;         //culoare FOW, alpha pentru opacitate
   float2 Tex0 : TEXCOORD0;      //textura de distort (normal map)
   float2 Tex1 : TEXCOORD1;      //textura din RTarget
   
};
//versiune cu culoare vertex si calculare automata de coord textura RTT
struct VS_OUTPUT 
{
   float4 Position :        POSITION0;
   float4 Color :           COLOR0;
   float2 Tex0 :            TEXCOORD0; 
   float2 Tex1:             TEXCOORD1;
};

VS_OUTPUT vs_main( VS_INPUT Input )
{
   VS_OUTPUT Output;

   Output.Position         = mul( Input.Position, matViewProjection );

   Output.Color = Input.Color; //culoarea apei din C++
    //adauga la coord textura apa offseturile in fn de timp si grupez cei 2 vectory xy si zw pe o sg coord tex
   Output.Tex0 = Input.Tex0;
   //calculez tex1 (RTT) in fn de coordonatele vertexului (inainte sa transform pozitia)
   //ca optimizare (2 instructiuni asm) le salvez in vectori.xy
   float2 RTTxy, RTTwh;
   float2 RTTtex_xy, RTTtex_wh;
   RTTxy = RTTxywh.xy; RTTwh = RTTxywh.zw;
   RTTtex_xy = RTTtex_xywh.xy; RTTtex_wh = RTTtex_xywh.zw;
   Output.Tex1 = ((Input.Position.xy - RTTxy) / RTTwh) * RTTtex_wh + RTTtex_xy;
   
   return( Output );
   
}
]]></RmShaderCode>
      <RmShaderConstant NAME="RTTtex_xywh" API="" REGISTER="5"/>
      <RmShaderConstant NAME="RTTxywh" API="" REGISTER="4"/>
      <RmShaderConstant NAME="matViewProjection" API="" REGISTER="0"/>
     </RmHLSLShader>
     <RmHLSLShader NAME="Pixel Shader" API="D3D" PIXEL_SHADER="TRUE" TARGET="ps_2_0" ENTRY_POINT="ps_main" COMPILER_FLAGS="0"><RmShaderCode TYPE="TEXT"><![CDATA[
float4 fFOWData; //x=pixel size, y=areaW, z=areaH

sampler2D texAll;  //textura render target (ul-diffuse, ur-normal+height, dl-specular power?)

struct PS_INPUT 
{
   float4 VertColor:       COLOR0;    //culoare apa (alpha pt transparenta apa)
   float2 Tex0:            TEXCOORD0; //coordonate textura distort
   float2 Tex1:            TEXCOORD1; //textura render target
};

//varianta cu alb negru
/*
float4 ps_main( PS_INPUT Input ) : COLOR0
{
   //aflu distort
   float4 tex1 = tex2D(texFOWNorm, Input.Tex0);
   float2 fowNrm = fFOWData.x * Input.VertColor.w * (tex1.xy - 0.5f);
   //iau culoare scena
   float4 sceneCol = tex2D(texAll, Input.Tex1 + fowNrm.xy);
   //facem alb negru
   //luminosity
   //float channel = sceneCol.x * 0.21f + sceneCol.y * 0.7f + sceneCol.z * 0.07f;
   //average
   float channel = (sceneCol.x + sceneCol.y + sceneCol.z) / 3.0f;

   float4 diffuseCol = float4(channel, channel, channel, sceneCol.w) * Input.VertColor;
   
   return saturate(diffuseCol);
}
*/
//varianta cu pixelate
/*
float4 ps_main( PS_INPUT Input ) : COLOR0
{
   float2 denom = float2(fFOWData.y / fFOWData.x, fFOWData.z / fFOWData.x);
   float2 texc = floor(Input.Tex1 * denom) / denom;
   //iau culoare scena
   float4 sceneCol = tex2D(texAll, texc);
   //facem alb negru
   //luminosity
   //float channel = sceneCol.x * 0.21f + sceneCol.y * 0.7f + sceneCol.z * 0.07f;
   //average
   float channel = (sceneCol.x + sceneCol.y + sceneCol.z) / 3.0f;

   float4 diffuseCol = float4(channel, channel, channel, sceneCol.w) * Input.VertColor;
   
   return saturate(diffuseCol);
}
*/
//varianta cu blackout
float4 ps_main( PS_INPUT Input ) : COLOR0
{
   //iau culoare scena
   float4 sceneCol = tex2D(texAll, Input.Tex1);
   //facem alb negru
   //luminosity
   //float channel = sceneCol.x * 0.21f + sceneCol.y * 0.7f + sceneCol.z * 0.07f;
   //average
   float channel = (sceneCol.x + sceneCol.y + sceneCol.z) / 3.0f;
   channel = floor(channel * 4.0f) / 12.0f;

   float4 diffuseCol = float4(channel, channel, channel, sceneCol.w) * Input.VertColor;
   
   return saturate(diffuseCol);
}]]></RmShaderCode>
      <RmSampler NAME="texAll" API="" REGISTER="0"/>
     </RmHLSLShader>

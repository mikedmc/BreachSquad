     <RmHLSLShader NAME="Vertex Shader" API="D3D" PIXEL_SHADER="FALSE" TARGET="vs_2_0" ENTRY_POINT="vs_main" COMPILER_FLAGS="0"><RmShaderCode TYPE="TEXT"><![CDATA[
struct VS_OUTPUT
{
   float4 pos       : POSITION0;
   float2 texCoord  : TEXCOORD0;
};

VS_OUTPUT vs_main( float4 inPos: POSITION )
{
   VS_OUTPUT o = (VS_OUTPUT) 0;

   inPos.xy = sign( inPos.xy);
   o.pos = float4( inPos.xy, 0.0f, 1.0f);

   // get into range [0,0.5f]
   o.texCoord = (float2(o.pos.x, -o.pos.y) + 1.0f)/2.0f;
   
   return o;
}
]]></RmShaderCode></RmHLSLShader>
     <RmHLSLShader NAME="Pixel Shader" API="D3D" PIXEL_SHADER="TRUE" TARGET="ps_2_0" ENTRY_POINT="ps_main" COMPILER_FLAGS="0"><RmShaderCode TYPE="TEXT"><![CDATA[
float fDistort;  //water distortion level
float4 fowColor;

sampler2D texAll;
sampler2D texFOW;
//versiunea de baza
/*
float4 ps_main( float2 texCoord  : TEXCOORD0) : COLOR
{
   //aflu culoare nava
   float4 tex1 = tex2D(texFOW, texCoord);
   float2 fowNrm = fDistort * fowColor.w * (tex1.xy - 0.5f);
   
   float4 sceneCol = tex2D(texAll, texCoord + fowNrm.xy);
   float4 diffuseCol = sceneCol * fowColor;
   
   return saturate(diffuseCol);
}
*/
//versiunea cu monocrom
/*
float4 ps_main( float2 texCoord  : TEXCOORD0) : COLOR
{
   //aflu culoare nava
   float4 tex1 = tex2D(texFOW, texCoord);
   float2 fowNrm = fDistort * fowColor.w * (tex1.xy - 0.5f);
   
   float4 sceneCol = tex2D(texAll, texCoord + fowNrm.xy);
   float4 diffuseCol = sceneCol * fowColor;
   
   float fnoise = tex1.x * 0.2f;
   float channel = diffuseCol.x * 0.21f + diffuseCol.y * 0.7f + diffuseCol.z * 0.07f;
   channel -= fnoise;
   return (float4(channel, channel, channel, diffuseCol.w));
}
*/
//versiune cu pixelate
float4 ps_main( float2 texCoord  : TEXCOORD0) : COLOR
{
   //aflu culoare nava
   //float4 tex1 = tex2D(texFOW, texCoord);
   //float2 fowNrm = fDistort * fowColor.w * (tex1.xy - 0.5f);
   
   float2 texc = texCoord;
   texc = floor(texc * 25.0f) / 25.0f;
   //texc.y = floor(texc.y * 10.0f) / 10.0f;
   float4 diffuseCol = tex2D(texAll, texc);
   float channel = diffuseCol.x * 0.21f + diffuseCol.y * 0.7f + diffuseCol.z * 0.07f;
   return (float4(channel, channel, channel, diffuseCol.w));
   /*
   float fnoise = tex1.x * 0.2f;
   float channel = diffuseCol.x * 0.21f + diffuseCol.y * 0.7f + diffuseCol.z * 0.07f;
   channel -= fnoise;
   return (float4(channel, channel, channel, diffuseCol.w));
   */
}
]]></RmShaderCode>

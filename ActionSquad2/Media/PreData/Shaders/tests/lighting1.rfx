     <RmHLSLShader NAME="Vertex Shader" API="D3D" PIXEL_SHADER="FALSE" TARGET="vs_2_0" ENTRY_POINT="vs_main" COMPILER_FLAGS="32"><RmShaderCode TYPE="TEXT"><![CDATA[
float4x4 matViewProjection;
float4 RTTxywh;
float4 RTTtex_xywh;

struct VS_INPUT 
{
   float4 Position : POSITION0;
   float3 Normal : NORMAL;       //vector catre lumina  
   float4 Color : COLOR0;
   float2 Tex0 : TEXCOORD0;      //textura spotului
   float2 Tex1 : TEXCOORD1;      //textura din RTarget
   
};

/*
//versiunea initiala cu toate datele trimise din engine si fara culoare vertex
struct VS_OUTPUT 
{
   float4 Position :        POSITION0;
   float2 Tex0 :            TEXCOORD0;
   float2 Tex1:             TEXCOORD1;
   float3 dirToLight :      TEXCOORD2;
};

VS_OUTPUT vs_main( VS_INPUT Input )
{
   VS_OUTPUT Output;

   Output.Position         = mul( Input.Position, matViewProjection );
   Output.dirToLight       = Input.Normal;

   Output.Tex0 = Input.Tex0; //textura spotului o ia direct
   Output.Tex1 = Input.Tex1;   
   
   return( Output );
   
}
*/
//versiune cu culoare vertex
/*
struct VS_OUTPUT 
{
   float4 Position :        POSITION0;
   float4 Color :           COLOR0;
   float2 Tex0 :            TEXCOORD0;
   float2 Tex1:             TEXCOORD1;
   float3 dirToLight :      TEXCOORD2;
};

VS_OUTPUT vs_main( VS_INPUT Input )
{
   VS_OUTPUT Output;

   Output.Position         = mul( Input.Position, matViewProjection );
   Output.dirToLight       = Input.Normal;

   Output.Tex0 = Input.Tex0; //textura spotului o ia din c++
   Output.Tex1 = Input.Tex1; //textura projective o ia din c++  
   Output.Color = Input.Color; //culoarea luminii din C++
   
   return( Output );
   
}
*/
//versiune cu culoare vertex si calculare automata de coord textura RTT
struct VS_OUTPUT 
{
   float4 Position :        POSITION0;
   float4 Color :           COLOR0;
   float2 Tex0 :            TEXCOORD0;
   float2 Tex1:             TEXCOORD1;
   float3 dirToLight :      TEXCOORD2;
};

VS_OUTPUT vs_main( VS_INPUT Input )
{
   VS_OUTPUT Output;

   Output.Position         = mul( Input.Position, matViewProjection );
   Output.dirToLight       = Input.Normal;

   Output.Color = Input.Color; //culoarea luminii din C++
   Output.Tex0 = Input.Tex0; //textura spotului o ia din c++
   //calculez tex1 (RTT) in fn de coordonatele vertexului (inainte sa transform pozitia)
   //ca optimizare (2 instructiuni asm) le salvez in vectori.xy
   float2 RTTxy, RTTwh;
   float2 RTTtex_xy, RTTtex_wh;
   RTTxy = RTTxywh.xy; RTTwh = RTTxywh.zw;
   RTTtex_xy = RTTtex_xywh.xy; RTTtex_wh = RTTtex_xywh.zw;
   Output.Tex1 = ((Input.Position.xy - RTTxy) / RTTwh) * RTTtex_wh + RTTtex_xy;

   //Output.Tex1.x = ((Input.Position.x - RTTxywh.x) / RTTxywh.z) * RTTtex_xywh.z + RTTtex_xywh.x;
   //Output.Tex1.y = ((Input.Position.y - RTTxywh.y) / RTTxywh.w) * RTTtex_xywh.w + RTTtex_xywh.y;
   
   return( Output );
   
}
]]></RmShaderCode>
      <RmShaderConstant NAME="RTTtex_xywh" API="" REGISTER="5"/>
      <RmShaderConstant NAME="RTTxywh" API="" REGISTER="4"/>
      <RmShaderConstant NAME="matViewProjection" API="" REGISTER="0"/>
     </RmHLSLShader>
     <RmHLSLShader NAME="Pixel Shader" API="D3D" PIXEL_SHADER="TRUE" TARGET="ps_2_0" ENTRY_POINT="ps_main" COMPILER_FLAGS="0"><RmShaderCode TYPE="TEXT"><![CDATA[
float4 fSpecularData; //x=spec power

sampler2D texAll;  //textura render target (ul-diffuse, ur-normal+height, dl-specular power?)
sampler2D texSpot;

struct PS_INPUT 
{
   float4 VertColor:       COLOR0;    //culoare lumina
   float2 Tex0:            TEXCOORD0; //textura spot
   float2 Tex1:            TEXCOORD1; //textura render target
   float3 dirToLight :     TEXCOORD2; //directia catre lumina
};

/*
// varianta fara culoarea luminii
float4 fShadowData; //x=shad bias, y=shad scale, z = shad penumbra
float4 ps_main( PS_INPUT Input ) : COLOR0
{
   //aflu culoare nava
   float4 diffuseCol = tex2D(texAll, Input.Tex1);
   float3 dirLight = normalize(Input.dirToLight);
   //2.a. aflu normala din normal map
   float4 normalH = tex2D(texAll, float2(Input.Tex1.x + 0.5f, Input.Tex1.y));
   float3 normal = normalize(normalH.xyz * 2.0f - 1.0f);
   //normal = float3(0.0f, 0.0f, 1.0f);
   float texH = normalH.w; //inaltimea din heightmap
   float fNdotL = max(0.0f, dot(dirLight, normal));
   //3. calculez specular
   float3 fvReflection     = reflect(dirLight, normal);
   //3.a.calculez dot refl cu view dir. Fiind constanta se poate optimiza (scot direct Z)
   //float3 fvViewDirection  = float3(0.0f, 0.0f, -1.0f);
   //float  fRDotV           = max( 0.0f, dot( fvReflection, fvViewDirection ) );
   //3.b.calculez dot refls cu view dir adica:
   float fRDotV = max(0.0f, -fvReflection.z);
   //4.a. iau specular intensity
   //float specularIntensity = tex2D(texAll, float2(texCoord.x, texCoord.y + 0.5f)).x;
   //4.b. setez specular intensity constant (ar trebui folosita metoda 4.a.)
   float specularIntensity = 1.0f; 
   
   float4 fvTotalSpecular  = fNdotL * specularIntensity * pow( fRDotV, fSpecularData.x );
   
   //iau culoare lumina si intensitate
   float4 spotColor = tex2D(texSpot, Input.Tex0);
   
   //5.a. verifica self shadwing
   //float3 checkpos = dirLight * fShadowData.x;
   //float chkH = tex2D(texAll, float2(Input.Tex1.x + 0.5f + checkpos.x, Input.Tex1.y + checkpos.y)).w;
   //float fShadow = clamp(sign(checkpos.z * fShadowData.y + texH - chkH), 0.4f, 1.0f); //0.4f e umbra totala ca sa nu apara negru full
   
   //float finalAlpha = diffuseCol.w;// * spotColor.w; //se inmulteste culoare difusa cu spot
   //culoare finala
   //float3 finalCol = diffuseCol.xyz * spotColor * fShadow;
   //5.b. fara self shadowing
   float finalAlpha = diffuseCol.w * spotColor.w; //se inmulteste culoare difusa cu spot
   //culoare finala
   float3 finalCol = diffuseCol.xyz * spotColor;
   
   return float4(finalCol * (fNdotL + fvTotalSpecular), finalAlpha);
}

*/

//varianta cu culoarea luminii luata din c++
//in tex de normals pe alpha codez specularIntensity
float4 ps_main( PS_INPUT Input ) : COLOR0
{
   //aflu culoare nava
   float4 diffuseCol = tex2D(texAll, Input.Tex1);
   float3 dirLight = normalize(Input.dirToLight);
   //2.a. aflu normala din normal map
   float4 normal_specular = tex2D(texAll, float2(Input.Tex1.x + 0.5f, Input.Tex1.y));
   float3 normal = normalize(normal_specular.xyz * 2.0f - 1.0f);
   float specularIntensity = normal_specular.w; //alpha din normal map 

   float fNdotL = max(0.0f, dot(dirLight, normal));
   //3. calculez specular
   float3 fvReflection     = reflect(dirLight, normal);
   //3.b.calculez dot refls cu view dir adica:
   float fRDotV = max(0.0f, -fvReflection.z);
   //specular total
   float4 fvTotalSpecular  = fNdotL * specularIntensity * pow( fRDotV, fSpecularData.x );
   
   //iau culoare lumina si intensitate
   float4 spotColor = tex2D(texSpot, Input.Tex0);
   
   //culoare finala
   float4 finalColor = diffuseCol * spotColor * Input.VertColor;
   
   return float4((finalColor.xyz * (fNdotL + fvTotalSpecular)), finalColor.w);
}
]]></RmShaderCode>

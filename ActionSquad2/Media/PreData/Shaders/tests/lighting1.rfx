     <RmHLSLShader NAME="Vertex Shader" API="D3D" PIXEL_SHADER="FALSE" TARGET="vs_2_0" ENTRY_POINT="vs_main" COMPILER_FLAGS="0"><RmShaderCode TYPE="TEXT"><![CDATA[
float3   vLightPos;

struct VS_OUTPUT
{
   float4 pos       : POSITION0;
   float2 texCoord  : TEXCOORD0;
   float3 dirToLight : TEXCOORD1;
};

VS_OUTPUT vs_main( float4 inPos: POSITION )
{
   VS_OUTPUT o = (VS_OUTPUT) 0;

   inPos.xy = sign( inPos.xy);
   o.pos = float4( inPos.xy, 0.0f, 1.0f);

   // get into range [0,0.5f]
   o.texCoord = (float2(o.pos.x, -o.pos.y) + 1.0f)/4.0f;
   
   //cosideram ca dreptunghiul este intr e-50,-50 si 50,50
   float2 vertpos = sign(inPos.xy) * float2(50.0f, 50.0f);
   //directia catre coordonata luminii
   o.dirToLight = vLightPos - float3(vertpos.xy, 0.0f);
   
   return o;
}
]]></RmShaderCode>
      <RmShaderConstant NAME="vLightPos" API="" REGISTER="0"/>
     </RmHLSLShader>
     <RmHLSLShader NAME="Pixel Shader" API="D3D" PIXEL_SHADER="TRUE" TARGET="ps_2_0" ENTRY_POINT="ps_main" COMPILER_FLAGS="0"><RmShaderCode TYPE="TEXT"><![CDATA[
float fSpecularPower;
float shadowBias;
float shadowScale;
float shadowPenumbra;

sampler2D texAll;
sampler2D texSpot;

float4 ps_main( float2 texCoord  : TEXCOORD0, float3 dirToLight:TEXCOORD1 ) : COLOR
{
   //aflu culoare nava
   float4 diffuseCol = tex2D(texAll, texCoord);
   float3 dirLight = normalize(dirToLight);
   //2.a. aflu normala din normal map
   float4 normalH = tex2D(texAll, float2(texCoord.x + 0.5f, texCoord.y));
   float3 normal = normalize(normalH.xyz * 2.0f - 1.0f);
   float texH = normalH.w; //inaltimea din heightmap
   float fNdotL = max(0.0f, dot(dirLight, normal));
   //3. calculez specular
   float3 fvReflection     = reflect(dirLight, normal);
   //3.a.calculez dot refl cu view dir. Fiind constanta se poate optimiza (scot direct Z)
   //float3 fvViewDirection  = float3(0.0f, 0.0f, -1.0f);
   //float  fRDotV           = max( 0.0f, dot( fvReflection, fvViewDirection ) );
   //3.b.calculez dot refls cu view dir adica:
   float fRDotV = max(0.0f, -fvReflection.z);
   //4. iau specular intensity
   float specularIntensity = tex2D(texAll, float2(texCoord.x, texCoord.y + 0.5f)).x;
   
   float4 fvTotalSpecular  = fNdotL * specularIntensity * pow( fRDotV, fSpecularPower );
   
   //iau culoare lumina si intensitate
   float4 spotColor = tex2D(texSpot, texCoord);
   
   //5. verifica self shadwing
   
   float3 checkpos = dirLight * shadowBias;
   float chkH = tex2D(texAll, float2(texCoord.x + 0.5f + checkpos.x, texCoord.y + checkpos.y)).w;
   float fShadow = clamp(sign(checkpos.z * shadowScale + texH - chkH), 0.4f, 1.0f);
   
   float finalAlpha = diffuseCol.w;// * spotColor.w; //se inmulteste culoare difusa cu spot
   //culoare finala
   float3 finalCol = diffuseCol.xyz * spotColor * fShadow;
   
   
   return float4(finalCol * (fNdotL + fvTotalSpecular), finalAlpha);
}

]]></RmShaderCode>
      <RmSampler NAME="texAll" API="" REGISTER="0"/>
      <RmSampler NAME="texSpot" API="" REGISTER="1"/>
      <RmShaderConstant NAME="shadowScale" API="" REGISTER="2"/>
      <RmShaderConstant NAME="fSpecularPower" API="" REGISTER="0"/>
      <RmShaderConstant NAME="shadowBias" API="" REGISTER="1"/>
     </RmHLSLShader>

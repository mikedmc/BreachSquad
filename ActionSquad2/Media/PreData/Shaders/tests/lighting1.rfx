     <RmHLSLShader NAME="Pixel Shader" API="D3D" PIXEL_SHADER="TRUE" TARGET="ps_2_0" ENTRY_POINT="ps_main" COMPILER_FLAGS="0"><RmShaderCode TYPE="TEXT"><![CDATA[
float4 fSpecularData; //x=spec power, y=spec intens

sampler2D texAll;  //textura render target (ul-diffuse, ur-normal+height, dl-specular power?)
sampler2D texSpot;

struct PS_INPUT 
{
   float4 VertColor:       COLOR0;    //culoare lumina
   float2 Tex0:            TEXCOORD0; //textura spot
   float2 Tex1:            TEXCOORD1; //textura render target
   float3 dirToLight :     TEXCOORD2; //directia catre lumina
};

/*
// varianta fara culoarea luminii
float4 fShadowData; //x=shad bias, y=shad scale, z = shad penumbra
float4 ps_main( PS_INPUT Input ) : COLOR0
{
   //aflu culoare nava
   float4 diffuseCol = tex2D(texAll, Input.Tex1);
   float3 dirLight = normalize(Input.dirToLight);
   //2.a. aflu normala din normal map
   float4 normalH = tex2D(texAll, float2(Input.Tex1.x + 0.5f, Input.Tex1.y));
   float3 normal = normalize(normalH.xyz * 2.0f - 1.0f);
   //normal = float3(0.0f, 0.0f, 1.0f);
   float texH = normalH.w; //inaltimea din heightmap
   float fNdotL = max(0.0f, dot(dirLight, normal));
   //3. calculez specular
   float3 fvReflection     = reflect(dirLight, normal);
   //3.a.calculez dot refl cu view dir. Fiind constanta se poate optimiza (scot direct Z)
   //float3 fvViewDirection  = float3(0.0f, 0.0f, -1.0f);
   //float  fRDotV           = max( 0.0f, dot( fvReflection, fvViewDirection ) );
   //3.b.calculez dot refls cu view dir adica:
   float fRDotV = max(0.0f, -fvReflection.z);
   //4.a. iau specular intensity
   //float specularIntensity = tex2D(texAll, float2(texCoord.x, texCoord.y + 0.5f)).x;
   //4.b. setez specular intensity constant (ar trebui folosita metoda 4.a.)
   float specularIntensity = 1.0f; 
   
   float4 fvTotalSpecular  = fNdotL * specularIntensity * pow( fRDotV, fSpecularData.x );
   
   //iau culoare lumina si intensitate
   float4 spotColor = tex2D(texSpot, Input.Tex0);
   
   //5.a. verifica self shadwing
   //float3 checkpos = dirLight * fShadowData.x;
   //float chkH = tex2D(texAll, float2(Input.Tex1.x + 0.5f + checkpos.x, Input.Tex1.y + checkpos.y)).w;
   //float fShadow = clamp(sign(checkpos.z * fShadowData.y + texH - chkH), 0.4f, 1.0f); //0.4f e umbra totala ca sa nu apara negru full
   
   //float finalAlpha = diffuseCol.w;// * spotColor.w; //se inmulteste culoare difusa cu spot
   //culoare finala
   //float3 finalCol = diffuseCol.xyz * spotColor * fShadow;
   //5.b. fara self shadowing
   float finalAlpha = diffuseCol.w * spotColor.w; //se inmulteste culoare difusa cu spot
   //culoare finala
   float3 finalCol = diffuseCol.xyz * spotColor;
   
   return float4(finalCol * (fNdotL + fvTotalSpecular), finalAlpha);
}

*/

//varianta cu culoarea luminii luata din c++
//in tex de normals pe alpha codez SELF ILLUMINATION
/*
float4 ps_main( PS_INPUT Input ) : COLOR0
{
   //aflu culoare nava
   float4 diffuseCol = tex2D(texAll, Input.Tex1);
   float3 dirLight = normalize(Input.dirToLight);
   //2.a. aflu normala din normal map
   float4 normal_specular = tex2D(texAll, float2(Input.Tex1.x + 0.5f, Input.Tex1.y));
   float3 normal = normalize(normal_specular.xyz * 2.0f - 1.0f);
   float selfIllumination = normal_specular.w; //alpha din normal map 

   float fNdotL = max(0.0f, dot(dirLight, normal));
   //3. calculez specular
   float3 fvReflection     = reflect(dirLight, normal);
   //3.b.calculez dot refls cu view dir (este perpendiculara pe Z)
   float fRDotV = max(0.0f, -fvReflection.z);
   //specular total
   float fvTotalSpecular  = fNdotL * pow( fRDotV, fSpecularData.x );
   
   //iau culoare lumina si intensitate
   float4 spotColor = tex2D(texSpot, Input.Tex0);
   
   //culoare finala - culoare perete * culoare spot * culoare vertex
   float4 finalColor = diffuseCol * spotColor * Input.VertColor;
   
   return float4((finalColor.xyz * saturate(fNdotL + fvTotalSpecular + selfIllumination)), finalColor.w);
}
*/


//varianta cu culoarea luminii luata din c++
//Ia specular intensity din alpha normal mapului si nu are self illumination pe point lights pt ca nu e necesar
//varianta corectata
float4 ps_main( PS_INPUT Input ) : COLOR0
{

   //in textura de normals avem XY pt normale, Z pt self illum. W este alpha si e necesara pt Render Target
   float4 normal_selfIllum = tex2D(texAll, float2(Input.Tex1.x + 0.5f, Input.Tex1.y));

   float3 fvLightDirection = normalize(Input.dirToLight);
   //float3 fvNormal       = normalize( (normal_selfIllum.xyz * 2.0f ) - 1.0f );
   float3 fvNormal         = float3(normal_selfIllum.xy, 1.0f);
   fvNormal                = normalize((fvNormal.xyz * 2.0f) - 1.0f);
   float  fNDotL           = dot( fvNormal, fvLightDirection ); 
   
   //float3 fvReflection     = normalize( ( ( 2.0f * fvNormal ) * ( fNDotL ) ) - fvLightDirection ); 
   float3 fvReflection      = reflect(fvLightDirection, fvNormal);
   float  fRDotV           = max(0.0f, -fvReflection.z);
   float4 fvBaseColor      = tex2D(texAll, Input.Tex1);

   //iau culoare lumina si intensitate
   float4 spotColor = tex2D(texSpot, Input.Tex0);
   
   float4 fvRealColor = (fvBaseColor * spotColor * Input.VertColor);
   float4 fvTotalDiffuse   = fNDotL * fvRealColor;
                              //intensity                     //power
   float4 fvTotalSpecular  = fSpecularData.y * pow( fRDotV, fSpecularData.x ) * fvRealColor;
   
   return( saturate(fvTotalDiffuse + fvTotalSpecular/* + fvSelfIllum */ ) );
}
]]></RmShaderCode>
      <RmSampler NAME="texAll" API="" REGISTER="0"/>
      <RmSampler NAME="texSpot" API="" REGISTER="1"/>
      <RmShaderConstant NAME="fSpecularData" API="" REGISTER="0"/>
     </RmHLSLShader>
     <RmStreamMapReference NAME="Stream Mapping" API=""/>
     <RmTextureObject NAME="texAll" API="D3D" STATE_INDEX="0" VERTEX_TEXTURE="FALSE">
      <RmTextureReference NAME="texAll" API=""/>
      <RmState NAME="D3DSAMP_MAGFILTER" API="D3D" STATE="5" VALUE="1" USAGE="SAMPLER_STATE"/>
      <RmState NAME="D3DSAMP_MINFILTER" API="D3D" STATE="6" VALUE="1" USAGE="SAMPLER_STATE"/>
      <RmState NAME="D3DSAMP_MIPFILTER" API="D3D" STATE="7" VALUE="0" USAGE="SAMPLER_STATE"/>
      <RmState NAME="D3DSAMP_ADDRESSU" API="D3D" STATE="1" VALUE="1" USAGE="SAMPLER_STATE"/>
      <RmState NAME="D3DSAMP_ADDRESSV" API="D3D" STATE="2" VALUE="1" USAGE="SAMPLER_STATE"/>
      <RmState NAME="D3DSAMP_ADDRESSW" API="D3D" STATE="3" VALUE="1" USAGE="SAMPLER_STATE"/>
     </RmTextureObject>
     <RmTextureObject NAME="texSpot" API="D3D" STATE_INDEX="1" VERTEX_TEXTURE="FALSE">
      <RmTextureReference NAME="texSpot" API=""/>
     </RmTextureObject>
    </RmPass>
   </RmDirectXEffect>
  </RmEffectGroup>
 </RmEffectWorkspace>
</RENDER_MONKEY>

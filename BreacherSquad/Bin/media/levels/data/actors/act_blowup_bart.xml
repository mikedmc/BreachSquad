<?xml version="1.0"?>

<ACTOR file="breacher.bsx">
	<ACTOR_DATA sAIstate="AWARE" sWeapon="WPN_SMG_MP5A3" class="ENEMY"
				bboxMinX="-8" bboxMinY="-12" bboxMaxX="8" bboxMaxY="4" heightZ="64" heartZ="32"
				sMaterial="FLESH" fLife="100.0" fArmor="0.0" 
				fSpeedMove="50.0" fSpeedRun="120.0"
				fSeeDist="320.0" fAttackMin="16.0" fAttackMax="64.0"
				fStunWhenHitProb="0.5"
				bCanCover="false" bCanInteract="false" />

	<SKINS>
	<!-- 
	layerVisibilityMask number - each bit is 0 or 1 where least important bit is layerIdx 1
	example: we have 6 layers and layer 1, 3 and 4 are visible in this skin => 1101 in binary is 13
	Skins have quick access layer indexes to the hands layers as we need to be able to hide and show them depending on weapon loadout
	-->
		<SKIN name="head1" layersVisibilityMask="27" handR_layerMask="16" handL_layerMask="8" />
		<SKIN name="head2" layersVisibilityMask="29" handR_layerMask="16" handL_layerMask="8" />
	</SKINS>

	<ANIMS>
		<!-- setting "set0" fills N,NE,SE,S with specified value -->
		<REFPOSE		set0="REFPOSE" />
		<IDLE			set0_N="IDLE_N" set0_NE="IDLE_NE" set0_SE="IDLE_SE" set0_S="IDLE_S" />	
		<RUN 			set0_N="RUN_N" set0_NE="RUN_NE" set0_SE="RUN_SE" set0_S="RUN_S" />
		<KICK			set0_N="KICK_N" set0_NE="KICK_NE" set0_SE="KICK_SE" set0_S="KICK_S" />
		<CROUCH			set0_N="CROUCH_N" set0_NE="CROUCH_NE" set0_SE="CROUCH_SE" set0_S="CROUCH_S" />
		<DIE			set0_N="DIE_N" set0_NE="DIE_N" set0_SE="DIE_S" set0_S="DIE_S" />
	</ANIMS>

	<VERSES>
    <!--
    <DIE set0="VOICE_ASSAULTER_DYING" set1="VOICE_ASSAULTER_DYING2" />
    <TAKING_DAMAGE set0="VOICE_ASSAULTER_WOUNDED" set1="VOICE_ASSAULTER_WOUNDED2" />
	-->
	</VERSES>

	<AI>
		<STATE name="IDLE" nPriority="0">
			<TRIGGERING_EVENTS>
				<AI_EVENT type="any" />
			</TRIGGERING_EVENTS>
			<BEHAVIORS>
				<BEHAVIOR name="AI_BEHAVIOR_IDLE" bCanInterrupt="true" />
			</BEHAVIORS>
		</STATE>
		
	  <STATE name="AWARE" nPriority="1">
		<TRIGGERING_EVENTS>
		  <AI_EVENT type="any" />
		</TRIGGERING_EVENTS>

		<BEHAVIORS>
		  <BEHAVIOR name="AI_BEHAVIOR_PATROL" fWaitTimer="1.0" />
		</BEHAVIORS>
	  </STATE>

	  <STATE name="AGGRESSIVE" nPriority="2">
		<TRIGGERING_EVENTS>
		  <AI_EVENT type="AI_EVENT_SEE_ENEMY" />
		  <AI_EVENT type="AI_EVENT_GOT_HIT" />
		</TRIGGERING_EVENTS>

		<BEHAVIORS>
		  <BEHAVIOR name="AI_BEHAVIOR_SURPRISED" fWaitTimer="0.25" />
		  <BEHAVIOR name="AI_BEHAVIOR_ATTACK" bCanInterrupt="false" />
		</BEHAVIORS>
	  </STATE>
	

		<STATE name="DEAD" nPriority="10">
			<TRIGGERING_EVENTS>
				<AI_EVENT type="AI_EVENT_DEAD" />
			</TRIGGERING_EVENTS>
			<BEHAVIORS>
				<BEHAVIOR name="AI_BEHAVIOR_DEAD" />
			</BEHAVIORS>
		</STATE>
	</AI>

</ACTOR>


<?xml version="1.0"?>

<SKELETON sSkeletonFile="assaulter1.skel" sAtlasFile="assaulter1.atlas" >

  <!-- 
  enumerate special bones in skeleton template in order to have access from the engine 
  values: AIM_IK, LEFT_FOOT_IK, RIGHT_FOOT_IK
  -->
  <SPECIAL_BONES>
    <BONE_AIM_IK          	sName="hand-back-IKT" />
	<BONE_GUN_MOUNT			sName="gun-mount" />
  </SPECIAL_BONES>

  <!-- 
  enumerate special slots so we have quick access to them 
  values: SLOT_LEFT_HAND, SLOT_LEFT_HAND_TOP, etc
  -->
  <SLOTS>
    <SLOT_HANDBK       sName="hand-back" />
    <SLOT_HANDBK_TOP   sName="pistol" />
  </SLOTS>
  
  <!-- event names for engine access -->
  <EVENTS>
    <EVENT_SHOOT          sName="shoot" />
    <EVENT_FOOTSTEP       sName="step" />
  </EVENTS>
  
</SKELETON>

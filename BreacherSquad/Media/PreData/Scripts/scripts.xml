  <ACTIVE_INC_FRAME step="1" loop="0" />
</script>

<!--- the object that's being toggled makes noise and alerts enemies -->
<script name="TOGGLE_HIDDEN_FLAG_NOISY">
  <IACTIVE_TOGGLE_HIDDEN />
